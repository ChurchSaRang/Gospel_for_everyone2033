# Local development uses SQLite.
DATABASE_URL="file:./dev.db"

# Required in every environment. Generate a unique random value of at least 32 characters.
NEXTAUTH_SECRET=""

# Resend transactional email settings (keep the API key private).
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# NOWPayments hosted invoice checkout.
PAYMENT_PROVIDER="nowpayments"
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
PAYMENT_PUBLIC_URL=""
SUPPORT_FEE_AMOUNT="500"
SUPPORT_FEE_CURRENCY="USD"

# Initial administrator account for running the database seed.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Production PostgreSQL connection strings. DATABASE_URL is pooled for app
# traffic; DATABASE_URL_UNPOOLED is direct for Prisma migrations.
DATABASE_URL_UNPOOLED=""
