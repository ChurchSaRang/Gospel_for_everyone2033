generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAYMENT_PENDING
  PAID
  PAID_WAITING_FOR_BATCH
  BATCH_ASSIGNED
  WITHDRAWN
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum BatchAllocationStatus {
  NOT_ELIGIBLE
  WAITING_FOR_PAYMENT
  UNASSIGNED
  ASSIGNED
  WAITING_FOR_BATCH
  TRANSFERRED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  APPLICATION_REVIEWER
  FINANCE_OFFICER
  BATCH_COORDINATOR
  CONTENT_MANAGER
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          AdminRole
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Applicant {
  id                String      @id @default(cuid())
  fullName          String
  email             String
  phone             String?
  country           String?
  age               Int?
  applicationStatus ApplicationStatus @default(SUBMITTED)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  applications      Application[]
  confirmationCodes ConfirmationCode[]
}

model Application {
  id                    String              @id @default(cuid())
  applicantId           String
  applicant             Applicant           @relation(fields: [applicantId], references: [id])
  reference             String              @unique
  preferredBatch        String?
  status               ApplicationStatus   @default(SUBMITTED)
  paymentStatus        PaymentStatus       @default(PENDING)
  batchAssignmentState BatchAllocationStatus @default(UNASSIGNED)
  termsVersion         String?
  termsAcceptedAt      DateTime?
  submissionDate       DateTime            @default(now())
  data                 String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  payments             Payment[]
  confirmationCodes    ConfirmationCode[]
}

model ConfirmationCode {
  id            String    @id @default(cuid())
  code          String    @unique
  applicantId   String
  applicationId String?
  applicant     Applicant @relation(fields: [applicantId], references: [id])
  application   Application? @relation(fields: [applicationId], references: [id])
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  applicationId     String
  application       Application   @relation(fields: [applicationId], references: [id])
  paymentReference  String        @unique
  provider          String
  amount            Decimal
  currency          String
  status            PaymentStatus @default(PENDING)
  webhookVerified   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  donation          Donation?
}

model Donation {
  id                 String       @id @default(cuid())
  donorName          String
  donorEmail         String
  amount             Decimal
  currency           String
  paymentReference   String       @unique
  paymentId          String?      @unique
  payment            Payment?     @relation(fields: [paymentId], references: [id])
  anonymous          Boolean      @default(false)
  status             PaymentStatus @default(PENDING)
  message            String?
  createdAt          DateTime     @default(now())
}

model Batch {
  id                String   @id @default(cuid())
  name              String   @unique
  code              String   @unique
  capacity          Int
  startDate         DateTime
  endDate           DateTime
  assignmentNumber  Int      @default(0)
  participantCount  Int      @default(0)
  isOpen            Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model Partner {
  id                String   @id @default(cuid())
  name              String
  description       String
  website           String?
  logoUrl           String?
  partnerType       String
  displayOrder      Int      @default(0)
  publicApproved    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NewsArticle {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String?
  content       String
  publishedAt   DateTime?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  imageUrl    String
  caption     String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model EmailLog {
  id            String   @id @default(cuid())
  recipient     String
  subject       String
  templateName  String
  status        String
  provider      String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String?
  action      String
  details     String?
  createdAt   DateTime @default(now())
}

model RefundRequest {
  id              String   @id @default(cuid())
  applicantName   String
  confirmationCode String
  batch           String?
  reason          String
  status          String   @default("PENDING")
  evidenceUrl     String?
  createdAt       DateTime @default(now())
}
