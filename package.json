{
  "name": "gosple-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run prisma:generate && next dev",
    "build": "npm run prisma:generate && next build",
    "build:production": "npm run prisma:generate:production && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:production": "prisma generate --schema prisma/postgres/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:production": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:seed": "npm run prisma:generate && node --env-file=.env prisma/seed.js",
    "db:seed:production": "npm run prisma:generate:production && node --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@prisma/client": "^6.4.0",
    "country-state-city": "^3.2.1",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "prisma": "^6.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
